<Window x:Class="GoldShop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="گالری طلای دلاریس"
Icon="/GoldShop;component/Images/logo.ico"
        Width="1000"
        Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Menu -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#DDD"
                BorderThickness="0,0,1,0">

            <StackPanel Margin="10">

                <!-- Logo -->
                <Image Source="Images/gold.png"
                       Width="200"
                       Height="200"
                       Margin="0,10,0,10"
                       Stretch="Uniform"/>

                <!-- Shop Title -->
                <TextBlock Text="Galary Tala Delaris"
                           Foreground="#D4AF37"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- ========================================== -->
                <!-- MENU BUTTONS – each has a unique name      -->
                <!-- ========================================== -->

                <Button x:Name="BtnBuySell"
                        Content="فروش طلا"
                        Height="55"
                        Margin="0,5"
                        Background="#D4AF37"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="BuySell_Click"/>




                <Button x:Name="BtnDashboard"
        Height="55"
        Margin="0,5"
        Background="#D4AF37"
        Foreground="White"
        FontWeight="Bold"
        Click="Dashboard_Click">
                    <StackPanel>
                        <TextBlock Text="صندوق مشتریان" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="طلای آب شده" HorizontalAlignment="Center" FontSize="11" Opacity="0.9"/>
                    </StackPanel>
                </Button>




            </StackPanel>

        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1"
              Background="#f5f5f5">
            <ContentControl x:Name="MainContent"/>
        </Grid>

    </Grid>
</Window>