<UserControl x:Class="GoldShop.Pages.ClientsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pdtt="https://github.com/Behnam2064/PersianDateTimeWPFTools"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Client Info + Action Buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="ClientNameText" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="ClientPhoneText" Foreground="#666"/>
                    <TextBlock x:Name="ClientNoteText" Foreground="#666" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClientStockText" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
                <Button Content="اصلاح موجودی" Width="120" Height="35"
                        Click="AdjustInventory_Click"/>
                <Button Content="انتخاب مشتری" Width="120" Height="35"
                        Margin="0,5,0,0"
                        Click="SelectClient_Click"
                        Background="#2196F3" Foreground="White" FontWeight="Bold"/>

                <Button Grid.Column="2" Content="🖨 چاپ تاریخچه" Width="120" Height="35"
            Margin="0,5,0,0" VerticalAlignment="Bottom"
            Click="PrintClientHistory_Click"
            Background="white" Foreground="black" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Transaction Entry -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="نوع" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TransactionTypeCombo" Height="30" Width="130"
                              SelectionChanged="TransactionTypeCombo_SelectionChanged">
                        <ComboBoxItem Content="خرید مشتری" IsSelected="True"/>
                        <ComboBoxItem Content="فروش مشتری"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="وزن (گرم)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TransactionWeightBox" Height="30"
                             PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                             TextChanged="TransactionInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="نرخ هر گرم" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TransactionCostBox" Height="30" Width="90"
                 PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                 TextChanged="TransactionCostBox_TextChanged"/>
                        <Button Content="🔄" Width="50" Height="30" Margin="5,0,0,0"
                Click="RefreshPrice_Click" ToolTip="بروزرسانی قیمت"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="سود فروشنده %" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TransactionPercentageBox" Height="30"
                             PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                             TextChanged="TransactionInput_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="تاریخ" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <pdtt:PersianDatePicker x:Name="TransactionDatePicker" Height="30" Width="120"
                                            CustomCultureName="fa-IR"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,10,0">
                    <TextBlock Text="مبلغ کل پرداختی" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TransactionTotalText" Height="30" IsReadOnly="True"
                             Background="#F0F0F0" FontWeight="Bold"
                             TextAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="6" Margin="0,0,0,0">
                    <TextBlock Text="سود شما" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TransactionProfitText" Height="30" IsReadOnly="True"
                             Background="#FFF3E0" FontWeight="Bold"
                             TextAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Note + Save Button -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="یادداشت تراکنش" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="TransactionNoteBox" Height="30" VerticalContentAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="ثبت تراکنش" Width="120" Height="35"
                    VerticalAlignment="Bottom" Click="SaveTransaction_Click"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            
        </Grid>

        <!-- History DataGrid -->
        <DataGrid Grid.Row="3" x:Name="ClientTransactionsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="نوع" Binding="{Binding TypeDisplay}" Width="80"/>
                <DataGridTextColumn Header="وزن" Binding="{Binding WeightDisplay}" Width="80"/>
                <DataGridTextColumn Header="نرخ" Binding="{Binding CostPerGram, StringFormat=N0}" Width="100"/>
                <DataGridTextColumn Header="سود %" Binding="{Binding SellerPercentage, StringFormat=N2}" Width="70"/>
                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110"/>
                <DataGridTextColumn Header="موجودی بعد از تراکنش" Binding="{Binding RunningStock, StringFormat=N3}" Width="130"/>
                <DataGridTextColumn Header="تاریخ" Binding="{Binding DateDisplay}" Width="120"/>
                <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>