<UserControl x:Class="GoldShop.Pages.SellPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pdtt="https://github.com/Behnam2064/PersianDateTimeWPFTools"
             xmlns:pages="clr-namespace:GoldShop.Pages">

    <TabControl>
        <!-- TAB 1: NEW SALE -->
        <TabItem Header="ثبت فروش">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ==================== SUMMARY PANEL ==================== -->
                <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="خلاصه فروش و سود" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <!-- Today -->
                                <Border Background="#FF9800" CornerRadius="5" Padding="10,5" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="امروز" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TodayWeightText" Text="0 گرم" Foreground="White"/>
                                        <TextBlock x:Name="TodayProfitText" Text="0 سود" Foreground="White"/>
                                        <TextBlock x:Name="TodayDateRange" Text="" Foreground="White" FontSize="10" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>
                                <!-- This Week -->
                                <Border Background="#FF9800" CornerRadius="5" Padding="10,5" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="این هفته" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WeekWeightText" Text="0 گرم" Foreground="White"/>
                                        <TextBlock x:Name="WeekProfitText" Text="0 سود" Foreground="White"/>
                                        <TextBlock x:Name="WeekDateRange" Text="" Foreground="White" FontSize="10" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>
                                <!-- This Month -->
                                <Border Background="#FF9800" CornerRadius="5" Padding="10,5">
                                    <StackPanel>
                                        <TextBlock Text="این ماه" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="MonthWeightText" Text="0 گرم" Foreground="White"/>
                                        <TextBlock x:Name="MonthProfitText" Text="0 سود" Foreground="White"/>
                                        <TextBlock x:Name="MonthDateRange" Text="" Foreground="White" FontSize="10" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Inventory + Reset -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBlock Text="موجودی فعلی" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CurrentStockText" Text="0 گرم" FontWeight="Bold" FontSize="20"/>
                            <Button Content="اصلاح موجودی" Width="120" Height="35" Margin="0,10,0,0"
                                    Click="AdjustStock_Click" Background="#4CAF50" Foreground="White"/>
                            <Button Content="صفر کردن سود" Width="120" Height="35" Margin="0,5,0,0"
                                    Click="ResetProfit_Click" Background="#F44336" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== SALE FORM ==================== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- TITLE -->
                        <TextBlock Grid.Row="0"
                                   Text="فروش طلا"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,0,0,25"/>

                        <!-- ROW 1: DATE & CUSTOMER + PHONE -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="تاریخ" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <pdtt:PersianDatePicker x:Name="TransactionDate" Height="35" Width="140"
                                                        CustomCultureName="fa-IR"/>
                            </StackPanel>

                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="نام و نام خانوادگی" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="CustomerName" Height="35" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="تلفن" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBox x:Name="PhoneNumber" Height="35" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- SEPARATOR -->
                        <Border Grid.Row="3" Height="1" Background="#E0E0E0" Margin="0,5,0,15"/>

                        <!-- ROW 4: WEIGHT & COST PER GRAM & PURITY -->
                        <Grid Grid.Row="4" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="وزن به گرم" DockPanel.Dock="Left" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="Weight" Height="25" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                         TextChanged="CalculateValues"/>
                            </DockPanel>

                            <Grid Grid.Column="1" Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="نرخ" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <TextBox Grid.Column="1" x:Name="CostPerGram" Height="25" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" TextChanged="CostPerGram_TextChanged"
                                         PreviewKeyDown="PositiveNumber_PreviewKeyDown" GotFocus="CostPerGram_GotFocus"/>

                                <Button Grid.Column="2" Content="🔄" Width="30" Height="25" Margin="5,0,0,0"
                                        Click="RefreshPrice_Click" ToolTip="بروزرسانی قیمت"/>
                            </Grid>

                            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="عیار" DockPanel.Dock="Left" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="PurityComboBox" Height="25" Width="70"
          VerticalContentAlignment="Center" SelectedIndex="0"
          SelectionChanged="PurityComboBox_SelectionChanged">


                                    <ComboBoxItem Content="750"/>
                                    <ComboBoxItem Content="849"/>
                                    <ComboBoxItem Content="999"/>
                                </ComboBox>
                            </DockPanel>
                        </Grid>

                        <!-- ROW 5: PERCENTAGES -->
                        <Grid Grid.Row="5" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="اجرت ساخت %" DockPanel.Dock="Left" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="MakingPercentage" Height="25" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                         TextChanged="CalculateValues"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="10,0,10,0">
                                <TextBlock Text="سود فروشنده %" DockPanel.Dock="Left" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="SellerPercentage" Height="25" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                         TextChanged="CalculateValues"/>
                            </DockPanel>
                            <DockPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="مالیات %" DockPanel.Dock="Left" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="TaxPercentage" Height="25" VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                         TextChanged="CalculateValues"/>
                            </DockPanel>
                        </Grid>

                        <!-- ROW 6: FINAL COST -->
                        <Border Grid.Row="6" Margin="0,20,0,20" Padding="20" Background="#EEEEEE" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="بهای تمام شده" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="FinalCostText" Text="0" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Left">
                                    <TextBlock x:Name="MakingCostText" Text="اجرت ساخت : 0" FontSize="14" Foreground="#555555" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="SellerCostText" Text="سود فروشنده : 0" FontSize="14" Foreground="#555555" Margin="0,0,15,0"/>
                                    <TextBlock x:Name="TaxText" Text="مالیات : 0" FontSize="14" Foreground="#555555"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ROW 7: SAVE BUTTON -->
                        <Button Grid.Row="7" Content="ذخیره تراکنش" Height="45" Width="180"
                                HorizontalAlignment="Left" Click="SaveTransaction_Click"/>

                        <!-- ROW 8: NOTE -->
                        <StackPanel Grid.Row="8" Margin="0,20,0,0">
                            <TextBlock Text="یادداشت" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="NoteBox" Height="35" VerticalContentAlignment="Center"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- TAB 2: HISTORY -->
        <TabItem Header="تاریخچه">
            <pages:HistoryPage x:Name="HistoryPageControl"/>
        </TabItem>
    </TabControl>
</UserControl>