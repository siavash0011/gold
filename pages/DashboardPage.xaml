<UserControl x:Class="GoldShop.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pdtt="https://github.com/Behnam2064/PersianDateTimeWPFTools"
             xmlns:pages="clr-namespace:GoldShop.Pages"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Profit Summary -->
        <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="سود شما" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <Button Content="صفر کردن سود" Width="100" Height="30"
        HorizontalAlignment="Left" Margin="0,0,0,10"
        Click="ResetProfit_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#FF9800" CornerRadius="5" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="امروز" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TodayProfitText" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="TodayDateRange" Text="" Foreground="White" FontSize="10" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF9800" CornerRadius="5" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="این هفته" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WeekProfitText" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="WeekDateRange" Text="" Foreground="White" FontSize="10" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FF9800" CornerRadius="5" Padding="10,5">
                        <StackPanel>
                            <TextBlock Text="این ماه" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MonthProfitText" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                            <TextBlock x:Name="MonthDateRange" Text="" Foreground="White" FontSize="10" Opacity="0.8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" SelectedIndex="0">
            <TabItem Header="مشتریان">
                <pages:ClientsPage x:Name="ClientsPageControl"/>
            </TabItem>
            <TabItem Header="آخرین تراکنش ها">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Panel with horizontal scroll -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <TextBlock Text="از:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <pdtt:PersianDatePicker x:Name="FromDatePicker" Height="30" Width="140"
                                                        CustomCultureName="fa-IR"
                                                        SelectedDateChanged="DateRange_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <TextBlock Text="تا:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <pdtt:PersianDatePicker x:Name="ToDatePicker" Height="30" Width="140"
                                                        CustomCultureName="fa-IR"
                                                        SelectedDateChanged="DateRange_Changed"/>
                            </StackPanel>
                            <Button Content="امروز" Margin="0,0,5,0" Height="30" Padding="10,0" Click="Today_Click"/>
                            <Button Content="این هفته" Margin="0,0,5,0" Height="30" Padding="10,0" Click="Week_Click"/>
                            <Button Content="این ماه" Margin="0,0,5,0" Height="30" Padding="10,0" Click="Month_Click"/>
                            <Button Content="پاک کردن" Margin="0,0,5,0" Height="30" Padding="10,0" Click="Clear_Click"/>
                            <Button Content="🖨 چاپ" Margin="0,0,5,0" Height="30" Padding="10,0"
        Click="Print_Click"/>
                        </WrapPanel>
                    </ScrollViewer>

                    <DataGrid Grid.Row="1" x:Name="GeneralTransactionsGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding DateDisplay}" Width="130"/>
                            <DataGridTextColumn Header="نوع" Binding="{Binding TypeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="مشتری" Binding="{Binding CustomerName}" Width="120"/>
                            <DataGridTextColumn Header="تلفن" Binding="{Binding Phone}" Width="100"/>
                            <DataGridTextColumn Header="وزن (گرم)" Binding="{Binding Weight, StringFormat=N3}" Width="90"/>
                            <DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110"/>
                            <DataGridTextColumn Header="سود" Binding="{Binding Profit, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>