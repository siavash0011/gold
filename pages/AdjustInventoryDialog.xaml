<Window x:Class="GoldShop.Pages.AdjustInventoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اصلاح موجودی" Height="250" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="موجودی فعلی:" FontWeight="SemiBold"/>
            <TextBlock x:Name="CurrentStockText" FontSize="18" FontWeight="Bold" Margin="0,5,0,10"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="موجودی جدید:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="NewStockBox" Height="35" FontSize="16"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,20,0,0">
            <Button Content="ثبت" Width="80" Height="30" Click="Save_Click"/>
            <Button Content="انصراف" Width="80" Height="30" Margin="10,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>