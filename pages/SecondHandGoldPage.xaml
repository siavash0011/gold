<UserControl x:Class="GoldShop.Pages.SecondHandGoldPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pdtt="https://github.com/Behnam2064/PersianDateTimeWPFTools"
             FlowDirection="RightToLeft">

    <TabControl Margin="20">
        <!-- TAB 1: NEW TRANSACTION -->
        <TabItem Header="ثبت تراکنش">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Type -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="نوع" FontWeight="SemiBold" Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="TransactionTypeCombo" Height="30" Width="150"
                                  HorizontalAlignment="Left" SelectedIndex="0"
                                  SelectionChanged="TypeCombo_Changed">
                            <ComboBoxItem Content="خرید مشتری"/>
                            <ComboBoxItem Content="فروش مشتری"/>
                        </ComboBox>
                    </Grid>

                    <!-- Customer Name & Phone -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="نام مشتری" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="CustomerNameBox" Height="30"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="شماره تماس" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="PhoneNumberBox" Height="30"/>
                        </StackPanel>
                    </Grid>

                    <!-- Weight & Purity -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="وزن (گرم)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="WeightBox" Height="30" PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                     TextChanged="InputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="عیار" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <ComboBox x:Name="PurityCombo" Height="30" Width="100" HorizontalAlignment="Left"
                                      SelectedIndex="0" SelectionChanged="PurityCombo_Changed">
                                <ComboBoxItem Content="735"/>
                                <ComboBoxItem Content="740"/>
                                <ComboBoxItem Content="750"/>
                                <ComboBoxItem Content="849"/>
                                <ComboBoxItem Content="999"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Seller Percentage & Cost per gram -->
                    <Grid Grid.Row="3" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="درصد فروشنده %" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="SellerPercentageBox" Height="30"
                                     PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                     TextChanged="InputChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="نرخ هر گرم" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="CostPerGramBox" Height="30" Width="120"
                                         PreviewKeyDown="PositiveNumber_PreviewKeyDown"
                                         TextChanged="CostPerGram_TextChanged"/>
                                <Button Content="🔄" Width="30" Height="30" Margin="5,0,0,0"
                                        Click="RefreshPrice_Click" ToolTip="بروزرسانی قیمت"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Date -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <TextBlock Text="تاریخ" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <pdtt:PersianDatePicker x:Name="TransactionDate" Height="30" Width="140"
                                                CustomCultureName="fa-IR"/>
                    </StackPanel>

                    <!-- Totals -->
                    <Grid Grid.Row="5" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="مبلغ کل (تومان)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="TotalAmountText" Height="30" IsReadOnly="True"
                                     Background="#F0F0F0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="معادل 750 (گرم)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox x:Name="Equivalent750Text" Height="30" IsReadOnly="True"
                                     Background="#F0F0F0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Profit -->
                    <StackPanel Grid.Row="6" Margin="0,0,0,15">
                        <TextBlock Text="سود شما (تومان)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="ProfitText" Height="30" IsReadOnly="True"
                                 Background="#FFF3E0" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Note -->
                    <StackPanel Grid.Row="7" Margin="0,0,0,15">
                        <TextBlock Text="یادداشت" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="NoteBox" Height="60" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Save Button -->
                    <Button Grid.Row="8" Content="ذخیره تراکنش" Height="45" Width="180"
                            HorizontalAlignment="Left" Background="#4CAF50" Foreground="White"
                            FontWeight="Bold" Click="SaveTransaction_Click"/>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- TAB 2: HISTORY -->
        <TabItem Header="تاریخچه">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="تاریخچه طلای دسته دوم" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <Button Grid.Row="1" Content="🖨 چاپ تاریخچه" Width="120" Height="30" Margin="0,0,0,10"
                        HorizontalAlignment="Left" Click="PrintHistory_Click"/>
                <DataGrid Grid.Row="2" x:Name="TransactionsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="نوع" Binding="{Binding TypeDisplay}" Width="80"/>
                        <DataGridTextColumn Header="نام مشتری" Binding="{Binding CustomerName}" Width="120"/>
                        <DataGridTextColumn Header="تلفن" Binding="{Binding PhoneNumber}" Width="100"/>
                        <DataGridTextColumn Header="وزن" Binding="{Binding Weight, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="عیار" Binding="{Binding Purity}" Width="60"/>
                        <DataGridTextColumn Header="معادل 750" Binding="{Binding Equivalent750Weight, StringFormat=N3}" Width="90"/>
                        <DataGridTextColumn Header="نرخ" Binding="{Binding CostPerGram, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="درصد" Binding="{Binding SellerPercentage, StringFormat=N2}" Width="70"/>
                        <DataGridTextColumn Header="مبلغ کل" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="سود" Binding="{Binding Profit, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="تاریخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd HH:mm, ConverterCulture=fa-IR}" Width="120"/>
                        <DataGridTextColumn Header="یادداشت" Binding="{Binding Note}" Width="200"/>

                        <!-- Delete Button Column -->
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Background="Transparent" BorderThickness="0"
                                            Click="DeleteTransaction_Click" Tag="{Binding Id}"
                                            ToolTip="حذف این تراکنش"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>